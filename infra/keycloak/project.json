{
  "name": "keycloak",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:infra", "scope:backend"],
  "targets": {
    "up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up -d --wait keycloak"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python verify.py",
        "cwd": "infra/keycloak"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff check .",
        "cwd": "infra/keycloak"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff format .",
        "cwd": "infra/keycloak"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "inputs": ["default", "uv"],
      "options": {
        "command": "uv run ruff format --check .",
        "cwd": "infra/keycloak"
      }
    }
  }
}
